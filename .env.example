# API Keys
TAVILY_API_KEY=tvly-...
PINECONE_API_KEY=pcsk_...
INDEX_NAME=banamex-governance
GOOGLE_API_KEY=your_google_api_key_here  # Obligatoria: todos los agentes usan Gemini

# Observabilidad (LangSmith)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=banamex-data-steward

# Base de Datos PostgreSQL (Banamex)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=reto_banamex

# Modelos: LLM en Google Gemini; embeddings locales con Ollama
COORDINATOR_MODEL=gemini-3.5-flash
SQL_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=bge-large

# Procesador OCR LOCAL con Tesseract (los archivos no se envían a Gemini ni a Pinecone)
OCR_LANG=spa+eng   # idiomas de Tesseract
OCR_DPI=300        # resolución al renderizar páginas PDF escaneadas
OCR_MIN_CHARS=80   # páginas PDF con menos texto nativo que esto pasan por Tesseract
OCR_FORCE=false    # true = OCR con Tesseract en todas las páginas PDF
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # solo si tesseract no está en el PATH


